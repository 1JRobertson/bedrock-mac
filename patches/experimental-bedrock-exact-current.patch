+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Bedrock for Mac contributors.
+ * Optional local adapter; not an upstream Wine component.
+ */
+/* The usual Wine ntdll base is far beyond rel32 range. Allocate a private leaf
+ * relay near the callsite: JMP [RIP+0], followed by the exact shim address. It
+ * changes no register/stack state, so Windows leaf unwinding is correct. */
+static void *bad_allocate_relay(void *return_address,void *target_address)
+{
+    uintptr_t address=((uintptr_t)return_address+0xffff)&~(uintptr_t)0xffff;
+    const uintptr_t limit=(uintptr_t)return_address+0x7fff0000;
+    MEMORY_BASIC_INFORMATION memory;
+    for(;address<limit;){
+        void *base=(void *)address;SIZE_T size=0x1000;ULONG old;
+        if(NtQueryVirtualMemory(NtCurrentProcess(),base,MemoryBasicInformation,&memory,sizeof(memory),NULL))return NULL;
+        if(memory.State==MEM_FREE && (uintptr_t)memory.BaseAddress+memory.RegionSize>=address+0x1000 &&
+           !NtAllocateVirtualMemory(NtCurrentProcess(),&base,0,&size,MEM_RESERVE|MEM_COMMIT,PAGE_READWRITE)){
+            unsigned char *code=base;uint64_t target=(uintptr_t)target_address;
+            code[0]=0xff;code[1]=0x25;memset(code+2,0,4);memcpy(code+6,&target,8);
+            if(!NtFlushInstructionCache(NtCurrentProcess(),base,14) &&
+               !NtProtectVirtualMemory(NtCurrentProcess(),&base,&size,PAGE_EXECUTE_READ,&old))return base;
+            size=0;NtFreeVirtualMemory(NtCurrentProcess(),&base,&size,MEM_RELEASE);return NULL;
+        }
+        if((uintptr_t)memory.BaseAddress+memory.RegionSize<=address)return NULL;
+        address=((uintptr_t)memory.BaseAddress+memory.RegionSize+0xffff)&~(uintptr_t)0xffff;
+    }
+    return NULL;
+}
+
+static int bad_environment(const WCHAR *name,WCHAR *buffer,SIZE_T chars)
+{
+    UNICODE_STRING key,value;
+    NTSTATUS s;
+    RtlInitUnicodeString(&key,name);
+    value.Buffer=buffer;value.Length=0;value.MaximumLength=(chars-1)*sizeof(WCHAR);
+    s=RtlQueryEnvironmentVariable_U(NULL,&key,&value);
+    if(s==STATUS_VARIABLE_NOT_FOUND)return 0;
+    if(s)return -1;
+    buffer[value.Length/sizeof(WCHAR)]=0;
+    return value.Length/sizeof(WCHAR);
+}
