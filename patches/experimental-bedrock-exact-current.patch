+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Bedrock for Mac contributors.
+ * Optional local adapter; not an upstream Wine component.
+ */
+/* Private fast-v2: only the current-wrapper call inside verified general mode0.
+ * The original generic allocator retains admission, fallback, and EH ownership. */
+#include "current_reserve.h"
+#include "exact_manifest.h"
+static int bad_exact_enabled __attribute__((used));
+static uintptr_t bad_exact_caller __attribute__((used));
+static void *(WINAPI *bad_exact_original)(void *,void *,SIZE_T,SIZE_T);
+void *WINAPI bad_exact_current(void *allocator,void *descriptor,SIZE_T size,SIZE_T alignment)
+{
+    if(bad_try_current(allocator,descriptor,size,alignment))return descriptor;
+    return bad_exact_original(allocator,descriptor,size,alignment);
+}
+void WINAPI bad_exact_shim(void);
+/* Entry has the untouched general frame. Saved return is RBP+0x88 because
+ * general pushes8 GPRs, subtracts0xc8 and establishes RBP=RSP+0x80.
+ * Pure leaf dispatch: no stack mutation, no TLS marker, no new unwind lifetime. */
+__ASM_GLOBAL_FUNC(bad_exact_shim,
+    __ASM_SEH(".seh_endprologue\n\t")
+    "cmpl $0," __ASM_NAME("bad_exact_enabled") "(%rip)\n\t"
+    "je 1f\n\t"
+    "movq 0x88(%rbp),%rax\n\t"
+    "cmpq " __ASM_NAME("bad_exact_caller") "(%rip),%rax\n\t"
+    "jne 1f\n\t"
+    "jmp " __ASM_NAME("bad_exact_current") "\n"
+    "1:\tjmp *" __ASM_NAME("bad_exact_original") "(%rip)")
+
+static int bad_exact_verify(const struct brm_spec *spec,const unsigned char *raw,
+                            const unsigned char *image,SIZE_T image_size,int game)
+{
+    struct brm_spec headers=*spec;size_t i,j,k;
+    headers.region_count=0;headers.edit_count=0;
+    if(brm_verify_spec(&headers,"1",raw,spec->file_size,image,image_size,bedrock_refmove_sha256)!=BRM_APPLIED)return 0;
+    for(i=0;i<spec->region_count;i++){
+        const struct brm_region *r=&spec->regions[i];
+        if((SIZE_T)r->rva+r->size>image_size || (SIZE_T)r->file_offset+r->size>spec->file_size)return 0;
+        for(j=0;j<r->size;j++){
+            unsigned char expected=raw[r->file_offset+j];
+            if(game)for(k=0;k<brm_game_spec.edit_count;k++){
+                const struct brm_edit *e=&brm_game_spec.edits[k];
+                if(r->rva+j>=e->rva && r->rva+j<e->rva+e->size)expected=e->after[r->rva+j-e->rva];
+            }
+            if(image[r->rva+j]!=expected)return 0;
+        }
+    }
+    return !memcmp(image+spec->edits[0].rva,spec->edits[0].before,5);
+}
+
+static void bad_exact_pre_entry(void *image,SIZE_T image_size)
+{
+    const UNICODE_STRING *path=&NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    UNICODE_STRING basename,expected,nt_path={0};WCHAR setting[32];
+    const struct brm_spec *spec=&bad_exact_game_spec;
+    OBJECT_ATTRIBUTES attr;IO_STATUS_BLOCK io;FILE_STANDARD_INFORMATION info;
+    MEMORY_BASIC_INFORMATION memory;HANDLE file=0,section=0;
+    void *raw=NULL,*page=NULL,*relay=NULL;SIZE_T raw_size=0,page_size=5;
+    ULONG old=0,ignored;int n,i,start=0,game=1;BOOL writable=FALSE,changed=FALSE;
+    intptr_t distance;unsigned char patch[5];const char *failure="unknown";
+    for(i=0;i<path->Length/sizeof(WCHAR);i++)if(path->Buffer[i]=='\\'||path->Buffer[i]=='/')start=i+1;
+    basename.Buffer=path->Buffer+start;basename.Length=basename.MaximumLength=path->Length-start*sizeof(WCHAR);
+    RtlInitUnicodeString(&expected,L"Minecraft.Windows.exe");
+    if(!RtlEqualUnicodeString(&basename,&expected,TRUE)){
+        RtlInitUnicodeString(&expected,L"exact-sentinel.exe");
+        if(!RtlEqualUnicodeString(&basename,&expected,TRUE))return;
+        spec=&bad_exact_sentinel_spec;game=0;
+    }
+    n=bad_environment(L"BEDROCK_EXACT_CURRENT",setting,32);
+    if(!n || (n==3 && !memcmp(setting,L"off",6)))return;
+    failure="invalid BEDROCK_EXACT_CURRENT (expected control or fast)";
+    if(n==4 && !memcmp(setting,L"fast",8))bad_exact_enabled=1;
+    else if(n!=7 || memcmp(setting,L"control",14))goto failed;
+    failure="exact-current and allocation diagnostic must be mutually exclusive";
+    n=bad_environment(L"BEDROCK_ALLOC_DIAG",setting,32);
+    if(n && !(n==3 && !memcmp(setting,L"off",6)))goto failed;
+    if(game){
+        failure="exact-current requires BEDROCK_PRIVATE_REFMOVE_15203=1";
+        if(bad_environment(L"BEDROCK_PRIVATE_REFMOVE_15203",setting,32)!=1 || setting[0]!='1')goto failed;
+    }
+    failure="exact executable/refmove-loaded-byte guard";
+    if(RtlDosPathNameToNtPathName_U_WithStatus(path->Buffer,&nt_path,NULL,NULL))goto failed;
+    InitializeObjectAttributes(&attr,&nt_path,OBJ_CASE_INSENSITIVE,NULL,NULL);
+    if(NtOpenFile(&file,GENERIC_READ|SYNCHRONIZE,&attr,&io,FILE_SHARE_READ,FILE_SYNCHRONOUS_IO_NONALERT|FILE_NON_DIRECTORY_FILE))goto failed;
+    if(NtQueryInformationFile(file,&io,&info,sizeof(info),FileStandardInformation))goto failed;
+    if(info.EndOfFile.QuadPart!=spec->file_size || image_size!=spec->image_size)goto failed;
+    if(NtCreateSection(&section,SECTION_MAP_READ,NULL,NULL,PAGE_READONLY,SEC_COMMIT,file))goto failed;
+    if(NtMapViewOfSection(section,NtCurrentProcess(),&raw,0,0,NULL,&raw_size,ViewShare,0,PAGE_READONLY))goto failed;
+    if(raw_size<spec->file_size || !bad_exact_verify(spec,raw,image,image_size,game))goto failed;
+    bad_exact_original=(void *)((char *)image+(game?0x52f6320:BAD_EXACT_SENTINEL_ORIGINAL));
+    bad_exact_caller=(uintptr_t)image+(game?0xdff31e9:BAD_EXACT_SENTINEL_CALLER);
+    failure="nearby exact-current relay allocation";
+    relay=bad_allocate_relay((char *)image+spec->edits[0].rva+5,(void *)bad_exact_shim);
+    if(!relay)goto failed;
+    distance=(intptr_t)relay-((intptr_t)image+spec->edits[0].rva+5);
+    if(distance<(intptr_t)(-2147483647-1)||distance>2147483647)goto failed;
+    patch[0]=0xe8;for(i=0;i<4;i++)patch[i+1]=(uint32_t)distance>>(i*8);
+    page=(char *)image+spec->edits[0].rva;
+    failure="exact-current callsite memory protection";
+    if(NtQueryVirtualMemory(NtCurrentProcess(),page,MemoryBasicInformation,&memory,sizeof(memory),NULL))goto failed;
+    if(memory.State!=MEM_COMMIT || memory.Type!=MEM_IMAGE || (char *)memory.BaseAddress+memory.RegionSize<(char *)page+5 || (memory.Protect!=PAGE_EXECUTE_READ && memory.Protect!=PAGE_EXECUTE_WRITECOPY))goto failed;
+    if(NtProtectVirtualMemory(NtCurrentProcess(),&page,&page_size,PAGE_READWRITE,&old))goto failed;
+    writable=TRUE;
+    failure="exact-current transactional guard";
+    if(!bad_exact_verify(spec,raw,image,image_size,game))goto failed;
+    memcpy((char *)image+spec->edits[0].rva,patch,5);changed=TRUE;
+    if(NtFlushInstructionCache(NtCurrentProcess(),page,page_size))goto failed;
+    if(NtProtectVirtualMemory(NtCurrentProcess(),&page,&page_size,old,&ignored))goto failed;
+    writable=FALSE;
+    MESSAGE("[bedrock-exact-current] enabled mode=%s verified_refmove=%d call_rva=%x caller=%p\n",bad_exact_enabled?"fast":"control",game,spec->edits[0].rva,(void *)bad_exact_caller);
+    NtUnmapViewOfSection(NtCurrentProcess(),raw);NtClose(section);NtClose(file);RtlFreeUnicodeString(&nt_path);return;
+failed:
+    if(writable){if(changed)memcpy((char *)image+spec->edits[0].rva,spec->edits[0].before,5);NtFlushInstructionCache(NtCurrentProcess(),page,page_size);NtProtectVirtualMemory(NtCurrentProcess(),&page,&page_size,old,&ignored);}
+    MESSAGE("[bedrock-exact-current] REFUSED: %s; game entry will not run\n",failure);
+    NtTerminateProcess(NtCurrentProcess(),STATUS_INVALID_IMAGE_FORMAT);for(;;){}
+}
