+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 Bedrock for Mac contributors.
+ * Optional local adapter; not an upstream Wine component.
+ */
+/* Bedrock 1.26.5203.0 private prototype. No patching or process access here.
+ * Only the guarded current-wrapper call at 52f5cc2 may call this, after the leaf shim
+ * verifies the saved generic caller is the dynamic-copy return at dff31e9. It consumes the layout in
+ * allocator-diagnostic-spec.json and retains every real ownership operation.
+ * On false, call the unchanged original current-arena WRAPPER, not the general
+ * allocator. On true the optional descriptor (including valid at +0x30) is ready.
+ * The original general allocator owns admission and its exact slow fallback.
+ * No cached reservation, scope inference, lock removal, or borrowed backing.
+ */
+#ifndef BEDROCK_EXACT_RESERVE_H
+#define BEDROCK_EXACT_RESERVE_H
+#include <stdint.h>
+#include <stddef.h>
+
+#ifndef BEX_API
+#define BEX_API static
+#endif
+
+static uint64_t bex_read64(const void *base, size_t offset)
+{ return __atomic_load_n((const uint64_t *)((const unsigned char *)base + offset), __ATOMIC_RELAXED); }
+static uint32_t bex_read32(const void *base, size_t offset)
+{ return __atomic_load_n((const uint32_t *)((const unsigned char *)base + offset), __ATOMIC_RELAXED); }
+static void bex_add64(void *base, size_t offset, uint64_t amount)
+{ (void)__atomic_fetch_add((uint64_t *)((unsigned char *)base + offset), amount, __ATOMIC_SEQ_CST); }
+static void bex_write64(void *base, size_t offset, uint64_t value)
+{ __atomic_store_n((uint64_t *)((unsigned char *)base + offset), value, __ATOMIC_RELAXED); }
+
+/* A physically attempted reservation may fail after another thread wins CAS.
+ * Like reserve RVA52f6a50, its 16-bit attempt count is not rolled back. A handled
+ * miss returns valid=0, so the existing caller executes its unchanged fallback.
+ */
+BEX_API int bad_try_current(void *allocator, void *descriptor,
+                        size_t bytes, size_t alignment)
+{
+    void *arena, *owner;
+    uint64_t start1, length1, cursor1, start2, length2, cursor2;
+    uint64_t available1, available2, offset, generation, backing;
+    unsigned interval;
+    if (!allocator || !descriptor || !bytes || bytes > 1024 || alignment != 1 ||
+        bex_read32(allocator, 0x90) != 0) return 0;
+
+    arena = (void *)(uintptr_t)bex_read64(allocator, 0);
+    if (!arena) goto miss;
+    start1 = bex_read64(arena, 0x48);
+    length1 = bex_read64(arena, 0x50);
+    cursor1 = bex_read64(arena, 0x58);
+    start2 = bex_read64(arena, 0x60);
+    length2 = bex_read64(arena, 0x68);
+    cursor2 = bex_read64(arena, 0x70);
+    /* Reject surprising/overflowing metadata instead of broadening the fast path. */
+    if (length1 > UINT64_MAX - start1 || length2 > UINT64_MAX - start2 ||
+        cursor1 < start1 || cursor1 > start1 + length1 ||
+        cursor2 < start2 || cursor2 > start2 + length2) goto miss;
+    available1 = start1 + length1 - cursor1;
+    available2 = start2 + length2 - cursor2;
+    if (available1 > UINT64_MAX - available2 || bytes > available1 + available2) goto miss;
+    (void)__atomic_fetch_add((uint16_t *)((unsigned char *)arena + 0x80),
+                             (uint16_t)1, __ATOMIC_SEQ_CST);
+
+    for (interval = 0; interval != 2; ++interval) {
+        const size_t start_at = interval ? 0x60 : 0x48;
+        const size_t length_at = interval ? 0x68 : 0x50;
+        const size_t cursor_at = interval ? 0x70 : 0x58;
+        uint64_t *cursor = (uint64_t *)((unsigned char *)arena + cursor_at);
+        for (;;) {
+            uint64_t start = bex_read64(arena, start_at);
+            uint64_t length = bex_read64(arena, length_at);
+            uint64_t old = __atomic_load_n(cursor, __ATOMIC_RELAXED);
+            uint64_t next;
+            if (length > UINT64_MAX - start || old < start ||
+                old > start + length || bytes > start + length - old) break;
+            next = old + bytes;
+            offset = old;
+            if (__atomic_compare_exchange_n(cursor, &old, next, 0,
+                                            __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+                goto reserved;
+        }
+    }
+miss:
+    __atomic_store_n((unsigned char *)descriptor + 0x30, (unsigned char)0, __ATOMIC_RELAXED);
+    return 1;
+
+reserved:
+    /* Match refmove's true acquire; the existing caller releases this owner. */
+    bex_add64(arena, 0x78, bytes);
+    bex_add64(arena, 0x40, bytes);
+    owner = (void *)(uintptr_t)bex_read64(arena, 8);
+    generation = bex_read64(arena, 0x88);
+    bex_write64(arena, 0x90, generation);
+    __atomic_store_n((unsigned char *)arena + 0x98, (unsigned char)1, __ATOMIC_RELAXED);
+    if (owner)
+        (void)__atomic_fetch_add((uint32_t *)((unsigned char *)owner + 8),
+                                1, __ATOMIC_SEQ_CST);
+    backing = bex_read64(arena, 0);
+    bex_write64(descriptor, 0, backing);
+    bex_write64(descriptor, 8, (uint64_t)(uintptr_t)owner);
+    bex_write64(descriptor, 0x10, offset);
+    bex_write64(descriptor, 0x18, bytes);
+    bex_write64(descriptor, 0x20, 0);
+    bex_write64(descriptor, 0x28, generation);
+    bex_add64(allocator, 0x18, bytes);
+    __atomic_store_n((unsigned char *)descriptor + 0x30, (unsigned char)1, __ATOMIC_RELAXED);
+    return 1;
+}
+#endif
