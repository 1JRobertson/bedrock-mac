+// Use the same client-bound Token Broker exchange as the game's MSA IPC path.
+// Select by type instead of response order; publish renewal only after validation.
+fn package_ticket(tokens: &TokenManager, response: ExchangeUserTokenOutcome) -> Result<String, auth::XboxAuthError> {
+    let responses = match response {
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponseCollection(collection)) => collection.security_tokens,
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(token)) => vec![*token],
+        _ => return Err(auth::XboxAuthError::token_exchange()),
+    };
+    let mut ticket = None;
+    let mut renewal = None;
+    for response in responses {
+        if !chrono::DateTime::parse_from_rfc3339(&response.lifetime.expires)
+            .is_ok_and(|expires| expires.timestamp() > chrono::Utc::now().timestamp() + 60) {
+            return Err(auth::XboxAuthError::token_exchange());
+        }
+        match response.token_type.as_str() {
+            "urn:passport:compact" | "urn:passport:delegationcompact" => {
+                let binary = response.requested_security_token.binary_security_token
+                    .filter(|value| !value.value.is_empty()).ok_or_else(auth::XboxAuthError::token_exchange)?;
+                let value = if response.token_type == "urn:passport:delegationcompact" {
+                    format!("d={}", binary.value)
+                } else { binary.value };
+                if ticket.replace(value).is_some() { return Err(auth::XboxAuthError::token_exchange()); }
+            },
+            "urn:passport:legacy" => {
+                let encrypted = response.requested_security_token.encrypted_data
+                    .ok_or_else(auth::XboxAuthError::token_exchange)?;
+                let address = encrypted.key_info.key_name.clone()
+                    .unwrap_or(response.applies_to.endpoint_reference.address);
+                if address != PASSPORT_STS || renewal.is_some() {
+                    return Err(auth::XboxAuthError::token_exchange());
+                }
+                let serialized = quick_xml::se::to_string(&encrypted)
+                    .map_err(|_| auth::XboxAuthError::token_exchange())?;
+                let (binary_secret, tpm_key) = match response.requested_proof_token {
+                    Some(proof) => (Some(proof.binary_secret), proof.encrypted_key.map(|key| key.cipher_data.cipher_value)),
+                    None => (None, None),
+                };
+                renewal = Some(Token::Legacy(LegacyToken { key_name: encrypted.key_info.key_name,
+                    token: serialized, binary_secret, tpm_key, lifetime: response.lifetime }));
+            },
+            _ => return Err(auth::XboxAuthError::token_exchange()),
+        }
+    }
+    let ticket = ticket.ok_or_else(auth::XboxAuthError::token_exchange)?;
+    if let Some(renewal) = renewal {
+        tokens.save_user_token(PASSPORT_STS.to_owned(), renewal)
+            .map_err(|_| auth::XboxAuthError::token_exchange())?;
+    }
+    Ok(ticket)
+}
