+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tokens::PASSPORT_STS;
+
+    fn legacy(value: &str) -> Token {
+        Token::Legacy(LegacyToken { key_name: Some(PASSPORT_STS.into()), token: value.into(),
+            binary_secret: None, tpm_key: None, lifetime: lifetime() })
+    }
+
+    fn lifetime() -> soap::Timestamp {
+        soap::Timestamp { id: None, created: "2026-01-01T00:00:00Z".into(),
+            expires: "2050-01-01T00:00:00Z".into() }
+    }
+
+    fn compact() -> soap::RequestSecurityTokenResponse {
+        soap::RequestSecurityTokenResponse {
+            token_type: "urn:passport:delegationcompact".into(),
+            applies_to: soap::AppliesTo { endpoint_reference: soap::EndpointReference { address: "scope-fixture".into() } },
+            lifetime: lifetime(), requested_security_token: soap::RequestedSecurityToken {
+                encrypted_data: None, binary_security_token: Some(soap::BinarySecurityTokenRes {
+                    id: "fixture".into(), value: "compact-fixture".into(), value_type: None }) },
+            requested_proof_token: None,
+        }
+    }
+
+    fn refresh() -> soap::RequestSecurityTokenResponse {
+        let mut value = compact();
+        value.token_type = "urn:passport:legacy".into();
+        value.applies_to.endpoint_reference.address = "http://Passport.NET/tb".into();
+        value.requested_security_token.binary_security_token = None;
+        value.requested_security_token.encrypted_data = Some(soap::EncryptedData::devicesoftware("new-refresh-fixture".into()));
+        value
+    }
+
+    fn stored(tokens: &TokenManager) -> String {
+        let Token::Legacy(value) = tokens.get_user_sts_token().unwrap() else { panic!("legacy fixture expected"); };
+        value.token
+    }
+
+    #[test]
+    fn package_ticket_selects_compact_and_keeps_refreshed_sts_in_the_same_session() {
+        for responses in [vec![compact(), refresh()], vec![refresh(), compact()]] {
+            let tokens = TokenManager::with_memory();
+            tokens.save_user_token(PASSPORT_STS.into(), legacy("old-user-fixture")).unwrap();
+            tokens.save_device_token(PASSPORT_STS.into(), legacy("device-fixture")).unwrap();
+            let result = package_ticket(&tokens, ExchangeUserTokenOutcome::Issued(
+                soap::BodyContent::RequestSecurityTokenResponseCollection(soap::RequestSecurityTokenResponseCollection { security_tokens: responses })));
+            assert_eq!(result.unwrap(), "d=compact-fixture");
+            assert!(stored(&tokens).contains("new-refresh-fixture"));
+            let Token::Legacy(device) = tokens.get_device_sts_token().unwrap() else { panic!("legacy fixture expected"); };
+            assert_eq!(device.token, "device-fixture");
+        }
+    }
+
+    #[test]
+    fn invalid_or_ambiguous_ticket_responses_preserve_saved_credentials() {
+        let mut malformed = compact();
+        malformed.requested_security_token.binary_security_token = None;
+        for responses in [vec![], vec![compact(), compact(), refresh()], vec![malformed, refresh()]] {
+            let tokens = TokenManager::with_memory();
+            tokens.save_user_token(PASSPORT_STS.into(), legacy("old-user-fixture")).unwrap();
+            assert!(package_ticket(&tokens, ExchangeUserTokenOutcome::Issued(
+                soap::BodyContent::RequestSecurityTokenResponseCollection(soap::RequestSecurityTokenResponseCollection { security_tokens: responses }))).is_err());
+            assert_eq!(stored(&tokens), "old-user-fixture");
+        }
+    }
+
+    #[test]
+    fn single_compact_response_keeps_its_format_and_existing_session() {
+        let tokens = TokenManager::with_memory();
+        tokens.save_user_token(PASSPORT_STS.into(), legacy("old-user-fixture")).unwrap();
+        let mut response = compact();
+        response.token_type = "urn:passport:compact".into();
+        let ticket = package_ticket(&tokens, ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponse(Box::new(response)))).unwrap();
+        assert_eq!(ticket, "compact-fixture");
+        assert_eq!(stored(&tokens), "old-user-fixture");
+    }
+
+    #[test]
+    fn expired_or_unrelated_renewal_does_not_replace_saved_credentials() {
+        let mut expired = refresh();
+        expired.lifetime.expires = "2000-01-01T00:00:00Z".into();
+        let mut unrelated = refresh();
+        unrelated.requested_security_token.encrypted_data.as_mut().unwrap()
+            .key_info.key_name = Some("unrelated-fixture".into());
+        for response in [expired, unrelated] {
+            let tokens = TokenManager::with_memory();
+            tokens.save_user_token(PASSPORT_STS.into(), legacy("old-user-fixture")).unwrap();
+            assert!(package_ticket(&tokens, ExchangeUserTokenOutcome::Issued(
+                soap::BodyContent::RequestSecurityTokenResponseCollection(
+                    soap::RequestSecurityTokenResponseCollection { security_tokens: vec![compact(), response] }))).is_err());
+            assert_eq!(stored(&tokens), "old-user-fixture");
+        }
+    }
+
+}
