+#ifndef BEDROCK_BINDING_CORE_H
+#define BEDROCK_BINDING_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#define BBR_RECORD_BYTES 1044u
+#define BBR_HASH_OFFSET 1040u
+#define BBR_SITES 3u
+#ifndef BBR_SLOTS
+#define BBR_SLOTS 32u
+#endif
+#ifndef BBR_CALL_LIMIT
+#define BBR_CALL_LIMIT UINT64_C(16384)
+#endif
+struct bbr_stats {
+    uint64_t calls,bytes,valid,unexpected_size,abi_mismatch;
+    uint64_t history_exact,history_same_source,consecutive_exact,consecutive_same_source,consecutive_source_equal;
+    uint64_t hash_collisions,history_misses,evictions,run_max,comparison_bytes,reserved;
+};
+struct bbr_entry {
+    uint64_t source_token,last_call;
+    uint32_t hash,valid;
+    unsigned char payload[BBR_RECORD_BYTES];
+};
+struct bbr_history {
+    struct bbr_stats sites[BBR_SITES];
+    struct bbr_entry entries[BBR_SLOTS];
+    uint64_t calls,last_source,run;
+    unsigned last_index,last_valid;
+};
+/* Source values are opaque observed addresses, never dereferenced or exported.
+ * A match does not establish encoder incarnation, frame identity or ownership.
+ * All three callsites use ONE history; the payload includes the original hash.
+ * Caller provides a successfully copied, valid destination; this core writes only
+ * its own bounded snapshots and numeric counters, never game memory. */
+static inline void bbr_break_sequence(struct bbr_history *h)
+{h->last_valid=0;h->last_source=0;h->run=0;}
+static inline int bbr_observe(struct bbr_history *h,unsigned site,uint64_t source_token,
+                             const void *destination,const void *result,size_t length)
+{
+    struct bbr_stats *s;unsigned i,selected=0,found=0;uint32_t hash;
+    struct bbr_entry *entry,*replacement;uint64_t run;
+    if(site>=BBR_SITES||h->calls>=BBR_CALL_LIMIT)return 0;
+    h->calls++;s=&h->sites[site];s->calls++;s->bytes+=length;
+    if(length!=BBR_RECORD_BYTES){s->unexpected_size++;bbr_break_sequence(h);return 1;}
+    if(!destination||result!=destination){s->abi_mismatch++;bbr_break_sequence(h);return 1;}
+    s->valid++;memcpy(&hash,(const unsigned char *)destination+BBR_HASH_OFFSET,sizeof(hash));
+    if(h->last_valid&&source_token&&source_token==h->last_source)s->consecutive_source_equal++;
+    replacement=&h->entries[0];
+    for(i=0;i<BBR_SLOTS;i++){
+        entry=&h->entries[i];
+        if(!entry->valid)replacement=entry;
+        else if(replacement->valid&&entry->last_call<replacement->last_call)replacement=entry;
+        if(!entry->valid||entry->hash!=hash)continue;
+        s->comparison_bytes+=BBR_RECORD_BYTES;
+        if(memcmp(entry->payload,destination,BBR_RECORD_BYTES)){s->hash_collisions++;continue;}
+        found=1;selected=i;replacement=entry;s->history_exact++;
+        if(source_token&&source_token==entry->source_token)s->history_same_source++;
+        break;
+    }
+    if(found&&h->last_valid&&selected==h->last_index){
+        s->consecutive_exact++;run=h->run+1;
+        if(source_token&&source_token==h->last_source)s->consecutive_same_source++;
+    }else run=1;
+    if(run>s->run_max)s->run_max=run;
+    if(!found){
+        s->history_misses++;if(replacement->valid)s->evictions++;
+        memcpy(replacement->payload,destination,BBR_RECORD_BYTES);
+        replacement->hash=hash;replacement->valid=1;
+    }
+    replacement->source_token=source_token;replacement->last_call=h->calls;
+    h->last_index=(unsigned)(replacement-h->entries);h->last_valid=1;
+    h->last_source=source_token;h->run=run;
+    return 1;
+}
+#endif
