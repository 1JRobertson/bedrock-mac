+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Included after the unchanged frame-slab worker/allocation wrappers. */
+#include "binding_control.h"
+static struct bbr_control *bbr_control;
+struct bbr_thread {
+    struct bbr_history history;
+    uint64_t inside_worker,outside_worker,completed_workers,exceptions;
+    unsigned depth;
+};
+static struct bbr_thread bbr_threads[BBR_THREADS];
+static bfr_native4 bbr_original_copy;
+static struct bbr_thread *bbr_current(unsigned *index)
+{
+    struct bfr_tls *t=bfr_tls_get();
+    if(!bbr_control||!t)return NULL;
+    *index=(unsigned)(t-bfr_threads);
+    return *index<BBR_THREADS?&bbr_threads[*index]:NULL;
+}
+static void bbr_publish(unsigned index,struct bbr_thread *t)
+{
+    struct bbr_row *r=&bbr_control->threads[index];unsigned i,s;
+    __atomic_fetch_add(&r->sequence,1,__ATOMIC_SEQ_CST);
+    __atomic_store_n(&r->calls,t->history.calls,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->inside_worker,t->inside_worker,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->outside_worker,t->outside_worker,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->completed_workers,t->completed_workers,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->exceptions,t->exceptions,__ATOMIC_RELAXED);
+    for(s=0;s<BBR_SITES;s++){
+        const uint64_t *source=(const uint64_t *)&t->history.sites[s];uint64_t *destination=(uint64_t *)&r->sites[s];
+        for(i=0;i<sizeof(struct bbr_stats)/8;i++)__atomic_store_n(&destination[i],source[i],__ATOMIC_RELAXED);
+    }
+    __atomic_fetch_add(&r->sequence,1,__ATOMIC_RELEASE);
+}
+static void bbr_after_copy(unsigned site,uintptr_t destination,uintptr_t source,size_t length,uintptr_t result)
+{
+    unsigned index=0;struct bbr_thread *t=bbr_current(&index);
+    if(!t)return;
+    if(__atomic_load_n(&bbr_control->armed,__ATOMIC_ACQUIRE)!=1){bbr_break_sequence(&t->history);return;}
+    if(!bbr_observe(&t->history,site,source,(void *)destination,(void *)result,length))return;
+    if(t->depth)t->inside_worker++;else t->outside_worker++;
+    if(!(t->history.calls&255)||t->history.calls==BBR_CALL_LIMIT)bbr_publish(index,t);
+}
+/* Original import thunk executes exactly once with unchanged four argument
+ * registers. Observe destination only after normal return, then return original
+ * RAX. Compiler-generated Win64 unwind metadata covers copy exceptions. */
+uintptr_t WINAPI bbr_copy_site0(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bbr_original_copy(a,b,c,d);bbr_after_copy(0,a,b,c,result);return result;}
+uintptr_t WINAPI bbr_copy_site1(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bbr_original_copy(a,b,c,d);bbr_after_copy(1,a,b,c,result);return result;}
+uintptr_t WINAPI bbr_copy_site2(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bbr_original_copy(a,b,c,d);bbr_after_copy(2,a,b,c,result);return result;}
+struct bbr_worker_context {struct bbr_thread *thread;unsigned index,depth;uint64_t calls;};
+static void bbr_worker_finally(BOOL normal,void *context)
+{
+    struct bbr_worker_context *s=(struct bbr_worker_context *)context;
+    s->thread->depth=s->depth;
+    if(s->thread->history.calls!=s->calls||!normal){
+        s->thread->completed_workers++;if(!normal)s->thread->exceptions++;
+        bbr_publish(s->index,s->thread);
+    }
+}
+uintptr_t WINAPI bbr_worker(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{
+    unsigned index=0;struct bbr_thread *t=bbr_current(&index);struct bbr_worker_context state;uintptr_t result;
+    if(!t||__atomic_load_n(&bbr_control->armed,__ATOMIC_ACQUIRE)!=1||t->history.calls>=BBR_CALL_LIMIT)
+        return bfr_worker(a,b,c,d);
+    state.thread=t;state.index=index;state.depth=t->depth;state.calls=t->history.calls;t->depth++;
+    __TRY {result=bfr_worker(a,b,c,d);}
+    __FINALLY_CTX(bbr_worker_finally,&state);
+    return result;
+}
