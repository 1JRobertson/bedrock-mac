+const ERROR_BODY_LIMIT: usize = 8192;
+const ERROR_BODY_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(2);
+
+/// Only fixed labels, counts and a numeric Xbox error survive this boundary.
+/// Never retain service text, request URLs, headers, tokens or reqwest errors.
+#[derive(Debug)]
+pub struct XboxAuthError {
+    stage: &'static str,
+    kind: &'static str,
+    status: Option<u16>,
+    media: &'static str,
+    body_state: &'static str,
+    bytes: usize,
+    json: Option<bool>,
+    xerr: Option<u64>,
+}
+
+impl XboxAuthError {
+    pub(super) fn token_exchange() -> Self {
+        Self::new("ms_token_exchange", "token_exchange")
+    }
+
+    fn new(stage: &'static str, kind: &'static str) -> Self {
+        Self { stage, kind, status: None, media: "unknown", body_state: "unread",
+            bytes: 0, json: None, xerr: None }
+    }
+}
+
+impl std::fmt::Display for XboxAuthError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "stage={};kind={};status={:?};media={};body={};bytes={};json={:?};xerr={:?}",
+            self.stage, self.kind, self.status, self.media, self.body_state,
+            self.bytes, self.json, self.xerr)
+    }
+}
+impl std::error::Error for XboxAuthError {}
+
+async fn read_auth_response(
+    mut response: reqwest::Response,
+    stage: &'static str,
+) -> Result<XstsResponse, XboxAuthError> {
+    let status = response.status();
+    let mut error = XboxAuthError::new(stage, "invalid_response");
+    error.status = Some(status.as_u16());
+    error.media = match response.headers().get(reqwest::header::CONTENT_TYPE)
+        .and_then(|value| value.to_str().ok())
+        .map(|value| value.split(';').next().unwrap_or("").trim()) {
+        None => "missing",
+        Some(value) if value.eq_ignore_ascii_case("application/json") => "json",
+        Some(value) if value.eq_ignore_ascii_case("text/html") => "html",
+        Some(_) => "other",
+    };
+    if status.is_success() {
+        // Keep the established success schema. Decode failures never expose text.
+        error.body_state = "unmeasured";
+        return response.json().await.map_err(|_| error);
+    }
+    error.kind = "http_status";
+    let mut bytes = Vec::new();
+    // Status is already known. Diagnostic collection must not hold a failure
+    // open for the account client's full request timeout (or indefinitely).
+    let read = async {
+        loop {
+            match response.chunk().await {
+                Ok(None) => { error.body_state = "complete"; break; }
+                Ok(Some(chunk)) => {
+                    let remaining = ERROR_BODY_LIMIT - bytes.len();
+                    bytes.extend_from_slice(&chunk[..chunk.len().min(remaining)]);
+                    if chunk.len() > remaining {
+                        error.body_state = "limited";
+                        break;
+                    }
+                }
+                Err(_) => { error.body_state = "read_error"; break; }
+            }
+        }
+    };
+    if tokio::time::timeout(ERROR_BODY_TIMEOUT, read).await.is_err() {
+        error.body_state = "timeout";
+    }
+    error.bytes = bytes.len();
+    if error.body_state == "complete" {
+        let parsed = serde_json::from_slice::<serde_json::Value>(&bytes);
+        error.json = Some(parsed.is_ok());
+        error.xerr = parsed.ok().and_then(|value| value.get("XErr").and_then(|x| x.as_u64()));
+    }
+    Err(error)
+}
+
+async fn send_auth(
+    client: &reqwest::Client,
+    endpoint: &str,
+    body: &impl serde::Serialize,
+    stage: &'static str,
+) -> Result<XstsResponse, XboxAuthError> {
+    let response = client.post(endpoint)
+        .header("Content-Type", "application/json")
+        .header("x-xbl-contract-version", "1")
+        .json(body).send().await.map_err(|error| {
+            XboxAuthError::new(stage, if error.is_timeout() { "timeout" }
+                else if error.is_connect() { "connect" } else { "request" })
+        })?;
+    read_auth_response(response, stage).await
+}
