+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    const CANARY: &str = "PRIVATE_FIXTURE_TOKEN_DO_NOT_LOG";
+
+    fn client() -> reqwest::Client {
+        // Loopback is an isolated fixture, never an override of a live endpoint.
+        reqwest::Client::builder().no_proxy()
+            .redirect(reqwest::redirect::Policy::none()).referer(false)
+            .timeout(std::time::Duration::from_secs(3)).build().unwrap()
+    }
+
+    async fn endpoint(status: u16, media: &str, body: Vec<u8>, declared: Option<usize>) -> String {
+        let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let header = format!("HTTP/1.1 {status} Fixture\r\nContent-Type: {media}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            declared.unwrap_or(body.len()));
+        tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut request = Vec::new();
+            let mut block = [0; 1024];
+            loop {
+                let count = stream.read(&mut block).await.unwrap();
+                assert!(count > 0 && request.len() + count <= 16384);
+                request.extend_from_slice(&block[..count]);
+                if request.windows(4).any(|part| part == b"\r\n\r\n") { break; }
+            }
+            // A reader enforcing the cap may close before the fixture finishes.
+            let _ = stream.write_all(header.as_bytes()).await;
+            let _ = stream.write_all(&body).await;
+            let _ = stream.shutdown().await;
+        });
+        format!("http://{address}/fixture?secret={CANARY}")
+    }
+
+    async fn response(status: u16, media: &str, body: &[u8]) -> reqwest::Response {
+        client().get(endpoint(status, media, body.to_vec(), None).await)
+            .header("Authorization", CANARY).send().await.unwrap()
+    }
+
+    fn redacted(error: &XboxAuthError) {
+        let display = error.to_string();
+        let debug = format!("{error:?}");
+        for text in [&display, &debug] {
+            assert!(!text.contains(CANARY));
+            assert!(!text.contains("127.0.0.1"));
+            assert!(!text.contains("Authorization"));
+        }
+        assert!(std::error::Error::source(error).is_none());
+    }
+
+    #[tokio::test]
+    async fn old_status_check_discards_even_a_present_json_error() {
+        let body = br#"{"XErr":2148916227,"Message":"fixture"}"#;
+        let error = response(400, "application/json", body).await.error_for_status().unwrap_err();
+        assert_eq!(error.status().unwrap().as_u16(), 400);
+        // This is the pinned pre-fix boundary: there is no Response left to read.
+        assert!(!error.to_string().contains("2148916227"));
+    }
+
+    #[tokio::test]
+    async fn empty_400_is_a_returned_error_with_observed_zero_bytes() {
+        let error = read_auth_response(response(400, "application/json", b"").await, "user_auth").await.unwrap_err();
+        assert_eq!((error.stage, error.kind, error.status), ("user_auth", "http_status", Some(400)));
+        assert_eq!((error.bytes, error.body_state, error.json, error.xerr), (0, "complete", Some(false), None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn json_400_preserves_only_numeric_xerr_and_counts() {
+        let body = format!(r#"{{"XErr":2148916227,"Message":"{CANARY}","Token":"{CANARY}"}}"#);
+        let error = read_auth_response(response(400, &format!("application/json; secret={CANARY}"), body.as_bytes()).await, "user_auth").await.unwrap_err();
+        assert_eq!((error.bytes, error.body_state, error.json, error.xerr), (body.len(), "complete", Some(true), Some(2148916227)));
+        assert_eq!(error.media, "json");
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn html_and_invalid_json_do_not_become_error_text() {
+        for (media, body) in [("text/html", format!("<html>{CANARY}</html>")),
+            ("application/json", format!(r#"{{"Message":"{CANARY}""#))] {
+            let error = read_auth_response(response(400, media, body.as_bytes()).await, "user_auth").await.unwrap_err();
+            assert_eq!((error.json, error.xerr), (Some(false), None));
+            redacted(&error);
+        }
+    }
+
+    #[tokio::test]
+    async fn non_numeric_xerr_is_never_copied() {
+        let body = format!(r#"{{"XErr":"{CANARY}"}}"#);
+        let error = read_auth_response(response(401, "application/json", body.as_bytes()).await, "xsts").await.unwrap_err();
+        assert_eq!((error.stage, error.json, error.xerr), ("xsts", Some(true), None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn oversized_body_is_bounded_and_not_parsed_as_complete() {
+        let error = read_auth_response(response(400, "text/html", &vec![b'x'; ERROR_BODY_LIMIT + 1]).await, "user_auth").await.unwrap_err();
+        assert_eq!((error.bytes, error.body_state, error.json, error.xerr), (ERROR_BODY_LIMIT, "limited", None, None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn broken_body_is_distinguished_from_an_observed_empty_body() {
+        let url = endpoint(400, "application/json", Vec::new(), Some(100)).await;
+        let response = client().get(url).send().await.unwrap();
+        let error = read_auth_response(response, "user_auth").await.unwrap_err();
+        assert_eq!((error.body_state, error.json, error.xerr), ("read_error", None, None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn redirect_is_not_accepted_as_authentication() {
+        let error = read_auth_response(response(302, "text/html", CANARY.as_bytes()).await, "user_auth").await.unwrap_err();
+        assert_eq!((error.kind, error.status), ("http_status", Some(302)));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn success_schema_and_invalid_success_response() {
+        let body = format!(r#"{{"NotAfter":"2099-01-01T00:00:00Z","Token":"{CANARY}","DisplayClaims":{{"xui":[{{"uhs":"fixture"}}]}}}}"#);
+        let token = read_auth_response(response(200, "application/json", body.as_bytes()).await, "user_auth").await.unwrap();
+        assert_eq!(token.token, CANARY);
+        assert_eq!(token.user_hash(), Some("fixture"));
+        let error = read_auth_response(response(200, "application/json", CANARY.as_bytes()).await, "user_auth").await.unwrap_err();
+        assert_eq!((error.kind, error.status), ("invalid_response", Some(200)));
+        assert_eq!((error.body_state, error.json), ("unmeasured", None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn exact_limit_body_is_complete_not_limited() {
+        let error = read_auth_response(response(400, "text/html", &vec![b'x'; ERROR_BODY_LIMIT]).await, "user_auth").await.unwrap_err();
+        assert_eq!((error.bytes, error.body_state, error.json), (ERROR_BODY_LIMIT, "complete", Some(false)));
+    }
+
+    #[tokio::test]
+    async fn partial_chunked_body_preserves_counts_without_parsing() {
+        let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut request = [0; 2048];
+            assert!(stream.read(&mut request).await.unwrap() > 0);
+            stream.write_all(b"HTTP/1.1 400 Fixture\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n").await.unwrap();
+            stream.write_all(format!("{:x}\r\n{CANARY}\r\n", CANARY.len()).as_bytes()).await.unwrap();
+            // Intentionally omit the terminating chunk to cause a body-read error.
+            stream.shutdown().await.unwrap();
+        });
+        let response = client().get(format!("http://{address}/fixture")).send().await.unwrap();
+        let result = read_auth_response(response, "user_auth").await;
+        server.await.unwrap();
+        let error = result.unwrap_err();
+        assert_eq!((error.bytes, error.body_state, error.json, error.xerr), (CANARY.len(), "read_error", None, None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn stalled_error_body_has_an_independent_diagnostic_deadline() {
+        let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut request = [0; 2048];
+            assert!(stream.read(&mut request).await.unwrap() > 0);
+            stream.write_all(b"HTTP/1.1 400 Fixture\r\nContent-Type: application/json\r\nContent-Length: 1000\r\nConnection: close\r\n\r\n").await.unwrap();
+            stream.write_all(CANARY.as_bytes()).await.unwrap();
+            std::future::pending::<()>().await;
+            drop(stream);
+        });
+        // This client has no request timeout: the diagnostic reader owns its cap.
+        let client = reqwest::Client::builder().no_proxy().build().unwrap();
+        let response = client.get(format!("http://{address}/fixture")).send().await.unwrap();
+        let result = tokio::time::timeout(std::time::Duration::from_secs(4), read_auth_response(response, "user_auth")).await;
+        server.abort();
+        let _ = server.await;
+        let error = result.expect("diagnostic reader exceeded its deadline").unwrap_err();
+        assert_eq!((error.status, error.bytes, error.body_state, error.json, error.xerr), (Some(400), CANARY.len(), "timeout", None, None));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn post_preserves_contract_headers_ticket_and_safe_error() {
+        let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut request = Vec::new();
+            let mut block = [0; 1024];
+            let (header_end, content_length) = loop {
+                let count = stream.read(&mut block).await.unwrap();
+                assert!(count > 0 && request.len() + count <= 16384);
+                request.extend_from_slice(&block[..count]);
+                if let Some(end) = request.windows(4).position(|part| part == b"\r\n\r\n") {
+                    let headers = std::str::from_utf8(&request[..end]).unwrap().to_ascii_lowercase();
+                    assert!(headers.starts_with("post /fixture http/1.1\r\n"));
+                    assert!(headers.lines().any(|line| line == "content-type: application/json"));
+                    assert!(headers.lines().any(|line| line == "x-xbl-contract-version: 1"));
+                    let length: usize = headers.lines().find_map(|line| line.strip_prefix("content-length: ")).unwrap().parse().unwrap();
+                    break (end + 4, length);
+                }
+            };
+            while request.len() - header_end < content_length {
+                let count = stream.read(&mut block).await.unwrap();
+                assert!(count > 0 && request.len() + count <= 16384);
+                request.extend_from_slice(&block[..count]);
+            }
+            let body: serde_json::Value = serde_json::from_slice(&request[header_end..]).unwrap();
+            assert_eq!(body, serde_json::json!({
+                "RelyingParty": "http://auth.xboxlive.com", "TokenType": "JWT",
+                "Properties": {"AuthMethod": "RPS", "SiteName": "user.auth.xboxlive.com", "RpsTicket": format!("d={CANARY}")}
+            }));
+            stream.write_all(b"HTTP/1.1 400 Fixture\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").await.unwrap();
+            stream.shutdown().await.unwrap();
+        });
+        let body = UserAuthRequest {
+            relying_party: "http://auth.xboxlive.com".into(), token_type: "JWT".into(),
+            properties: UserAuthProperties {auth_method: "RPS".into(), site_name: "user.auth.xboxlive.com".into(), rps_ticket: format!("d={CANARY}")}
+        };
+        let result = send_auth(&client(), &format!("http://{address}/fixture"), &body, "user_auth").await;
+        server.await.unwrap();
+        let error = result.unwrap_err();
+        assert_eq!((error.stage, error.status, error.bytes, error.body_state), ("user_auth", Some(400), 0, "complete"));
+        redacted(&error);
+    }
+
+    #[tokio::test]
+    async fn request_failure_returns_a_safe_error() {
+        let error = send_auth(&client(), &format!("invalid://fixture?secret={CANARY}"), &serde_json::json!({"Token": CANARY}), "user_auth").await.unwrap_err();
+        assert_eq!((error.kind, error.status, error.body_state), ("request", None, "unread"));
+        redacted(&error);
+    }
+}
