+/* PRIVATE, exact-build experiment. Not an upstream or general-purpose Wine fix. */
+#include "tomcrypt.h"
+#include "guarded_refmove.h"
+#include "bedrock_private_refmove_sentinel.h"
+
+static int bedrock_refmove_sha256( const unsigned char *data, size_t size, unsigned char digest[32] )
+{
+    hash_state state;
+    if (sha256_init( &state ) != CRYPT_OK) return 0;
+    while (size)
+    {
+        unsigned long chunk = min( size, 1024 * 1024 );
+        if (sha256_process( &state, data, chunk ) != CRYPT_OK) return 0;
+        data += chunk;
+        size -= chunk;
+    }
+    return sha256_done( &state, digest ) == CRYPT_OK;
+}
+
+/* Called exactly once from initial loader_init, before importing DLLs or running
+ * any process-attach/TLS callback. Never called from a running game thread. */
+static void bedrock_private_refmove_pre_entry( void *image, SIZE_T image_size )
+{
+    const UNICODE_STRING *path = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    UNICODE_STRING basename, expected, env_name, env_value, nt_path = {0};
+    WCHAR env_buffer[4];
+    const struct brm_spec *spec = &brm_game_spec;
+    const WCHAR *environment_name = L"BEDROCK_PRIVATE_REFMOVE_15203";
+    const char *target_name = "minecraft";
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    FILE_STANDARD_INFORMATION file_info;
+    MEMORY_BASIC_INFORMATION memory;
+    HANDLE file = 0, section = 0;
+    void *raw = NULL, *protect_base = NULL;
+    SIZE_T raw_size = 0, protect_size = 0;
+    ULONG old_protect = 0, ignored;
+    NTSTATUS status;
+    BOOL writable = FALSE, changed = FALSE;
+    const char *failure = "unknown";
+    unsigned int i, start = 0;
+
+    for (i = 0; i < path->Length / sizeof(WCHAR); i++)
+        if (path->Buffer[i] == '\\' || path->Buffer[i] == '/') start = i + 1;
+    basename.Buffer = path->Buffer + start;
+    basename.Length = basename.MaximumLength = path->Length - start * sizeof(WCHAR);
+    RtlInitUnicodeString( &expected, L"Minecraft.Windows.exe" );
+    if (!RtlEqualUnicodeString( &basename, &expected, TRUE ))
+    {
+        RtlInitUnicodeString( &expected, L"refmove-sentinel.exe" );
+        if (!RtlEqualUnicodeString( &basename, &expected, TRUE )) return; /* Ancillary processes. */
+        spec = &brm_sentinel_spec;
+        environment_name = L"BEDROCK_PRIVATE_REFMOVE_SENTINEL";
+        target_name = "sentinel";
+    }
+    RtlInitUnicodeString( &env_name, environment_name );
+    env_value.Buffer = env_buffer;
+    env_value.Length = 0;
+    env_value.MaximumLength = sizeof(env_buffer);
+    status = RtlQueryEnvironmentVariable_U( NULL, &env_name, &env_value );
+    if (status == STATUS_VARIABLE_NOT_FOUND || (!status && !env_value.Length)) return;
+    if (!status && env_value.Length == sizeof(WCHAR) && env_buffer[0] == '0') return;
+    failure = "invalid opt-in value";
+    if (status || env_value.Length != sizeof(WCHAR) || env_buffer[0] != '1') goto failed;
+
+    failure = "opening exact executable";
+    if (RtlDosPathNameToNtPathName_U_WithStatus( path->Buffer, &nt_path, NULL, NULL )) goto failed;
+    InitializeObjectAttributes( &attr, &nt_path, OBJ_CASE_INSENSITIVE, NULL, NULL );
+    if (NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ,
+                    FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE )) goto failed;
+    if (NtQueryInformationFile( file, &io, &file_info, sizeof(file_info), FileStandardInformation )) goto failed;
+    failure = "unsupported executable length";
+    if (file_info.EndOfFile.QuadPart != spec->file_size || image_size != spec->image_size) goto failed;
+    failure = "mapping read-only executable";
+    if (NtCreateSection( &section, SECTION_MAP_READ, NULL, NULL, PAGE_READONLY, SEC_COMMIT, file )) goto failed;
+    if (NtMapViewOfSection( section, NtCurrentProcess(), &raw, 0, 0, NULL, &raw_size,
+                           ViewShare, 0, PAGE_READONLY )) goto failed;
+    failure = "SHA256, PE identity, relocation or instruction guard";
+    if (raw_size < spec->file_size || brm_verify_spec( spec, "1", raw, spec->file_size, image, image_size,
+                                               bedrock_refmove_sha256 ) != BRM_APPLIED) goto failed;
+
+    /* Use the same protection/write primitive for both the real PE sentinel and
+     * the game. Require a single original protection region for exact restoration. */
+    {
+        SIZE_T first = ~(SIZE_T)0, last = 0;
+        for (i = 0; i < spec->edit_count; i++)
+        {
+            first = min( first, spec->edits[i].rva & ~(SIZE_T)0xfff );
+            last = max( last, (spec->edits[i].rva + spec->edits[i].size + 0xfff) & ~(SIZE_T)0xfff );
+        }
+        protect_base = (char *)image + first;
+        protect_size = last - first;
+    }
+    failure = "nonuniform original page protection";
+    if (NtQueryVirtualMemory( NtCurrentProcess(), protect_base, MemoryBasicInformation,
+                              &memory, sizeof(memory), NULL )) goto failed;
+    if (memory.State != MEM_COMMIT || memory.Type != MEM_IMAGE ||
+        (char *)memory.BaseAddress + memory.RegionSize < (char *)protect_base + protect_size ||
+        (memory.Protect != PAGE_EXECUTE_READ && memory.Protect != PAGE_EXECUTE_WRITECOPY)) goto failed;
+    failure = "making instruction pages temporarily writable";
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                PAGE_READWRITE, &old_protect )) goto failed;
+    writable = TRUE;
+    failure = "final transactional instruction guard";
+    /* A second raw hash here is deliberate: the guard core is also independently
+     * usable by the anonymous-image test, and all writes remain after all checks. */
+    if (brm_apply_spec_to_writable_private_image( spec, "1", raw, spec->file_size, image, image_size,
+                                            bedrock_refmove_sha256 ) != BRM_APPLIED) goto failed;
+    changed = TRUE;
+    for (i = 0; i < spec->edit_count; i++)
+        if (memcmp( (char *)image + spec->edits[i].rva, spec->edits[i].after, spec->edits[i].size )) goto failed;
+    failure = "flushing translated instruction cache";
+    if (NtFlushInstructionCache( NtCurrentProcess(), protect_base, protect_size )) goto failed;
+    failure = "restoring original instruction-page protection";
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                old_protect, &ignored )) goto failed;
+    writable = FALSE;
+    MESSAGE( "[bedrock-private-refmove] enabled target=%s full_sha256_verified=1 sites=%Iu image=%p\n", target_name, spec->edit_count, image );
+    NtUnmapViewOfSection( NtCurrentProcess(), raw );
+    NtClose( section );
+    NtClose( file );
+    RtlFreeUnicodeString( &nt_path );
+    return;
+
+failed:
+    /* Best-effort in-memory rollback, followed by unconditional process termination.
+     * A cache/protection restoration error must never launch a partially patched game. */
+    if (writable)
+    {
+        if (changed)
+            for (i = 0; i < spec->edit_count; i++)
+                memcpy( (char *)image + spec->edits[i].rva, spec->edits[i].before, spec->edits[i].size );
+        NtFlushInstructionCache( NtCurrentProcess(), protect_base, protect_size );
+        NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size, old_protect, &ignored );
+    }
+    if (raw) NtUnmapViewOfSection( NtCurrentProcess(), raw );
+    if (section) NtClose( section );
+    if (file) NtClose( file );
+    RtlFreeUnicodeString( &nt_path );
+    MESSAGE( "[bedrock-private-refmove] REFUSED: %s; game entry will not run\n", failure );
+    NtTerminateProcess( NtCurrentProcess(), STATUS_INVALID_IMAGE_FORMAT );
+    for (;;) {} /* Even an unexpected termination failure cannot enter game code. */
+}
