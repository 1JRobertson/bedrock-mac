+/* PRIVATE prototype, not linked into Wine. Only writable anonymous test images so far.
+ * A future loader adapter must call this before any game code/TLS executes, handle
+ * temporary page protection and instruction-cache flushing, and terminate on any
+ * protection/flush failure. It must never write the executable file.
+ */
+#ifndef GUARDED_REFMOVE_H
+#define GUARDED_REFMOVE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+struct brm_region { uint32_t rva, file_offset, size; };
+struct brm_edit { uint32_t rva, size; unsigned char before[10], after[10]; };
+#include "manifest.h"
+struct brm_spec {
+    size_t file_size, image_size;
+    const unsigned char *sha256;
+    const struct brm_region *regions; size_t region_count;
+    const struct brm_edit *edits; size_t edit_count;
+};
+static const struct brm_spec brm_game_spec = {
+    BRM_FILE_SIZE, BRM_IMAGE_SIZE, brm_expected_sha256,
+    brm_regions, sizeof(brm_regions)/sizeof(brm_regions[0]),
+    brm_edits, sizeof(brm_edits)/sizeof(brm_edits[0])
+};
+
+enum brm_result { BRM_DISABLED=0, BRM_APPLIED=1, BRM_BAD_ARGUMENT=-1,
+    BRM_BAD_FILE=-2, BRM_BAD_HEADERS=-3, BRM_CHANGED_FUNCTION=-4,
+    BRM_CHANGED_SITE=-5 };
+typedef int (*brm_sha256_fn)(const unsigned char *, size_t, unsigned char [32]);
+static uint32_t brm_u32(const unsigned char *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static uint64_t brm_u64(const unsigned char *p)
+{ return brm_u32(p) | (uint64_t)brm_u32(p+4)<<32; }
+
+/* Verifies EVERYTHING first; no partial write on a guard failure. The hash callback
+ * must compute SHA256 of the supplied raw bytes, not accept an environment digest.
+ * An exact raw hash binds the PE timestamp/PDB/build identity and all function data.
+ */
+static int brm_verify_spec(const struct brm_spec *spec, const char *opt_in,
+                     const unsigned char *raw, size_t raw_size,
+                     const unsigned char *image, size_t image_size, brm_sha256_fn hash)
+{
+    unsigned char digest[32]; uint32_t nt, opt; size_t i;
+    if (!opt_in || strcmp(opt_in,"1")) return BRM_DISABLED;
+    if (!raw || !image || !hash || raw_size!=spec->file_size || image_size!=spec->image_size)
+        return BRM_BAD_ARGUMENT;
+    if (!hash(raw,raw_size,digest) || memcmp(digest,spec->sha256,32)) return BRM_BAD_FILE;
+    nt=brm_u32(raw+0x3c); opt=nt+24;
+    if (nt>raw_size-264 || nt>image_size-264 ||
+        memcmp(image,raw,2) || brm_u32(image+0x3c)!=nt ||
+        memcmp(image+nt,raw+nt,24) || memcmp(image+opt,raw+opt,24) ||
+        memcmp(image+opt+32,raw+opt+32,80) ||
+        brm_u64(image+opt+24)!=(uintptr_t)image) return BRM_BAD_HEADERS;
+    for (i=0;i<spec->region_count;++i) {
+        const struct brm_region *r=&spec->regions[i];
+        if ((size_t)r->rva+r->size>image_size || (size_t)r->file_offset+r->size>raw_size ||
+            memcmp(image+r->rva,raw+r->file_offset,r->size)) return BRM_CHANGED_FUNCTION;
+    }
+    for (i=0;i<spec->edit_count;++i) {
+        const struct brm_edit *e=&spec->edits[i];
+        if ((size_t)e->rva+e->size>image_size || memcmp(image+e->rva,e->before,e->size))
+            return BRM_CHANGED_SITE;
+    }
+    return BRM_APPLIED; /* Means eligible here; no mutation in verify. */
+}
+
+/* This core neither changes page protections nor attaches to a process. It is
+ * deliberately unsuitable for invoking after game threads have started.
+ */
+static int brm_apply_spec_to_writable_private_image(const struct brm_spec *spec,const char *opt_in,
+                 const unsigned char *raw, size_t raw_size, unsigned char *image,
+                 size_t image_size, brm_sha256_fn hash)
+{
+    int result=brm_verify_spec(spec,opt_in,raw,raw_size,image,image_size,hash); size_t i;
+    if (result!=BRM_APPLIED) return result;
+    for (i=0;i<spec->edit_count;++i) {
+        const struct brm_edit *e=&spec->edits[i];
+        memcpy(image+e->rva,e->after,e->size);
+    }
+    return BRM_APPLIED;
+}
+#define brm_verify(...) brm_verify_spec(&brm_game_spec,__VA_ARGS__)
+#define brm_apply_to_writable_private_image(...) brm_apply_spec_to_writable_private_image(&brm_game_spec,__VA_ARGS__)
+#endif
