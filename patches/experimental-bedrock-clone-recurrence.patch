+#ifndef BEDROCK_CLONE_RECURRENCE_H
+#define BEDROCK_CLONE_RECURRENCE_H
+/* Observation only. No game memory writes, no allocations, locks, logging, or
+ * retained game pointers. Call only after the original constructor succeeds.
+ * Storage is exclusively owned by one thread; export after quiescence only. */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#ifndef CR_SLOTS
+#define CR_SLOTS 32u
+#endif
+#ifndef CR_MAX_PAYLOAD
+#define CR_MAX_PAYLOAD 2048u
+#endif
+#ifndef CR_SAMPLE_MASK
+#define CR_SAMPLE_MASK 63u /* probabilistic 1/64 selection, avoids periodic phase lock */
+#endif
+struct cr_metadata {
+    uint64_t copied_18, copied_70;
+    uint32_t count_capacity[4]; /* exact copied +38/+48/+58/+68 dwords */
+};
+struct cr_entry {
+    uint64_t hash, caller_rva, descriptor_token, frame_id, scope_generation;
+    uint64_t sample_sequence;
+    size_t length;
+    struct cr_metadata metadata;
+    unsigned char payload[CR_MAX_PAYLOAD];
+    unsigned valid;
+};
+struct cr_stats {
+    uint64_t calls, bytes, zero, oversized, invalid, sampled, comparisons;
+    uint64_t exact_payload, exact_metadata, same_observed_token;
+    uint64_t different_known_frames, different_known_scopes, exact_repeated_bytes;
+    uint64_t replacements, comparison_misses, clock_unknown;
+};
+struct cr_observer {
+    struct cr_stats stats;
+    struct cr_entry entries[CR_SLOTS];
+    uint64_t rng;
+};
+static inline uint64_t cr_hash(const unsigned char *p, size_t size) {
+    uint64_t h = UINT64_C(14695981039346656037);
+    for (size_t i = 0; i < size; ++i) h = (h ^ p[i]) * UINT64_C(1099511628211);
+    return h;
+}
+#ifndef CR_HASH
+#define CR_HASH cr_hash
+#endif
+static inline int cr_selected_caller(uint64_t rva) {
+    return rva == UINT64_C(0x5f07d8b) || rva == UINT64_C(0x5f9e417) ||
+           rva == UINT64_C(0x5f06c0f);
+}
+/* descriptor_token is an opaque observed address, NOT a proved lifetime ID.
+ * frame_id=0 / scope_generation=0 means unknown; never fabricate either.
+ * payload must refer to the freshly copied output allocation, valid for length.
+ * Hash collisions are checked by full byte comparison of saved copies.
+ * Counts describe sampled recurrence in a bounded cache, NOT cache correctness
+ * or an unbiased estimate of all calls. Do not scale hit rates by sample period. */
+static inline void cr_observe(struct cr_observer *o, uint64_t caller_rva,
+                              uint64_t descriptor_token, uint64_t frame_id,
+                              uint64_t scope_generation,
+                              const struct cr_metadata *metadata,
+                              const void *payload, size_t length) {
+    if (!cr_selected_caller(caller_rva)) return;
+    ++o->stats.calls;
+    o->stats.bytes += length;
+    if (!length) { ++o->stats.zero; return; }
+    if (length > CR_MAX_PAYLOAD) { ++o->stats.oversized; return; }
+    if (!metadata || !payload) { ++o->stats.invalid; return; }
+    uint64_t random = o->rng ? o->rng : UINT64_C(0x9e3779b97f4a7c15);
+    random ^= random << 13; random ^= random >> 7; random ^= random << 17;
+    o->rng = random;
+    if (random & CR_SAMPLE_MASK) return;
+    ++o->stats.sampled;
+    if (!frame_id) ++o->stats.clock_unknown;
+    const unsigned char *bytes = (const unsigned char *)payload;
+    uint64_t hash = CR_HASH(bytes, length);
+    /* Fully associative tiny cache avoids one frequently changing key pinning
+     * a bucket. LRU replacement gives a bounded and explicitly reported window. */
+    struct cr_entry *replacement = &o->entries[0];
+    for (size_t i = 0; i < CR_SLOTS; ++i) {
+        struct cr_entry *entry = &o->entries[i];
+        if (!entry->valid) replacement = entry;
+        else if (replacement->valid && entry->sample_sequence < replacement->sample_sequence)
+            replacement = entry;
+        if (!entry->valid || entry->caller_rva != caller_rva || entry->length != length || entry->hash != hash)
+            continue;
+        ++o->stats.comparisons;
+        if (memcmp(entry->payload, bytes, length)) { ++o->stats.comparison_misses; continue; }
+        ++o->stats.exact_payload;
+        if (!memcmp(&entry->metadata, metadata, sizeof(*metadata))) {
+            ++o->stats.exact_metadata;
+            o->stats.exact_repeated_bytes += length;
+            if (descriptor_token && descriptor_token == entry->descriptor_token)
+                ++o->stats.same_observed_token;
+            if (frame_id && entry->frame_id && frame_id != entry->frame_id)
+                ++o->stats.different_known_frames;
+            if (scope_generation && entry->scope_generation && scope_generation != entry->scope_generation)
+                ++o->stats.different_known_scopes;
+            replacement = entry;
+            break;
+        }
+        /* Count payload equality once even if cached under multiple metadata. */
+        replacement = entry;
+        break;
+    }
+    if (replacement->valid) ++o->stats.replacements;
+    replacement->hash = hash; replacement->caller_rva = caller_rva;
+    replacement->descriptor_token = descriptor_token; replacement->frame_id = frame_id;
+    replacement->scope_generation = scope_generation; replacement->length = length;
+    replacement->metadata = *metadata;
+    memcpy(replacement->payload, bytes, length);
+    replacement->sample_sequence = o->stats.sampled; replacement->valid = 1;
