+/* Extraction for this exact game's successfully returned 0x78-byte clone.
+ * output must already be proved valid by the constructor-return ABI; this helper
+ * deliberately does not chase the original source, allocator or caller frames. */
+static inline void cr_observe_clone(struct cr_observer *o, uint64_t caller_rva,
+                                    uint64_t descriptor_token, uint64_t frame_id,
+                                    uint64_t scope_generation, const void *output) {
+    if (!cr_selected_caller(caller_rva)) return;
+    if (!output) { ++o->stats.invalid; return; }
