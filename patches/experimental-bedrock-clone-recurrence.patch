+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Private observation only; include after the unchanged frame-slab adapter's
+ * worker and allocation wrappers. Never dereference saved game addresses. */
+#include "clone_recurrence.h"
+#include "observer_control.h"
+static struct bcr_control *bcr_control;
+struct bcr_thread {
+    struct cr_observer sites[BCR_SITES];
+    uint64_t calls,inside_worker,outside_worker,abi_mismatch,completed_workers,exceptions;
+    unsigned depth;
+};
+static struct bcr_thread bcr_threads[BFR_THREADS];
+static bfr_native4 bcr_original_clone;
+static const uint64_t bcr_return_rvas[BCR_SITES]={0x5f06c0f,0x5f07d8b,0x5f9e417};
+static struct bcr_thread *bcr_current(unsigned *index)
+{
+    struct bfr_tls *t=bfr_tls_get();
+    if(!bcr_control||!t)return NULL;
+    *index=(unsigned)(t-bfr_threads);
+    return *index<BCR_THREADS?&bcr_threads[*index]:NULL;
+}
+static void bcr_publish(unsigned index,struct bcr_thread *t)
+{
+    struct bcr_row *r=&bcr_control->threads[index];
+    uint64_t *destination;const uint64_t *source;unsigned i,s;
+    /* Single writer per registered thread. All shared words are atomic; an
+     * even unchanged sequence gives the native reader one consistent snapshot. */
+    __atomic_fetch_add(&r->sequence,1,__ATOMIC_SEQ_CST);
+    __atomic_store_n(&r->calls,t->calls,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->inside_worker,t->inside_worker,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->outside_worker,t->outside_worker,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->abi_mismatch,t->abi_mismatch,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->completed_workers,t->completed_workers,__ATOMIC_RELAXED);
+    __atomic_store_n(&r->exceptions,t->exceptions,__ATOMIC_RELAXED);
+    for(s=0;s<BCR_SITES;s++){
+        source=(const uint64_t *)&t->sites[s].stats;destination=(uint64_t *)&r->sites[s];
+        for(i=0;i<sizeof(struct cr_stats)/8;i++)__atomic_store_n(&destination[i],source[i],__ATOMIC_RELAXED);
+    }
+    __atomic_fetch_add(&r->sequence,1,__ATOMIC_RELEASE);
+}
+/* The constructor has the ordinary Win64 three-argument ABI and returns RCX.
+ * Call it exactly once; observe only after success. C-generated unwind info
+ * covers these frames if the original constructor throws; no TLS change here. */
+static void bcr_after_clone(unsigned site,uintptr_t destination,uintptr_t result)
+{
+    unsigned index=0;struct bcr_thread *t;
+    struct bfr_tls *frame_tls;uint64_t epoch=0,generation=0,token=0;
+    if(!bcr_control||__atomic_load_n(&bcr_control->armed,__ATOMIC_ACQUIRE)!=1)return;
+    t=bcr_current(&index);if(!t||t->calls>=BCR_CALL_LIMIT)return;
+    t->calls++;
+    if(t->depth)t->inside_worker++;else t->outside_worker++;
+    if(!destination||result!=destination){t->abi_mismatch++;bcr_publish(index,t);return;}
+    /* These clocks are known only under the existing proven frame lease.
+     * With CHUNK=0 both remain unknown; reused addresses are never a clock. */
+    frame_tls=bfr_tls_get();
+    memcpy(&token,(void *)result,sizeof(token));
+    if(frame_tls->active&&frame_tls->active->lease.pool&&token==frame_tls->active->token){
+        struct bfa_lease *lease=&frame_tls->active->lease;
+        epoch=lease->key.incarnation;
+        generation=__atomic_load_n(&lease->pool->slots[lease->key.slot].generation,__ATOMIC_RELAXED);
+    }
+    cr_observe_clone(&t->sites[site],bcr_return_rvas[site],0,epoch,generation,(void *)result);
+    if(!(t->calls&255)||t->calls==BCR_CALL_LIMIT)bcr_publish(index,t);
+}
+uintptr_t WINAPI bcr_clone_seed(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bcr_original_clone(a,b,c,d);bcr_after_clone(0,a,result);return result;}
+uintptr_t WINAPI bcr_clone_prepared(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bcr_original_clone(a,b,c,d);bcr_after_clone(1,a,result);return result;}
+uintptr_t WINAPI bcr_clone_render(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{uintptr_t result=bcr_original_clone(a,b,c,d);bcr_after_clone(2,a,result);return result;}
+struct bcr_worker_context {struct bcr_thread *thread;unsigned index,depth;uint64_t calls;};
+static void bcr_worker_finally(BOOL normal,void *context)
+{
+    struct bcr_worker_context *s=(struct bcr_worker_context *)context;
+    s->thread->depth=s->depth;
+    if(s->thread->calls!=s->calls||!normal){
+        s->thread->completed_workers++;if(!normal)s->thread->exceptions++;
+        bcr_publish(s->index,s->thread);
+    }
+}
+uintptr_t WINAPI bcr_worker(uintptr_t a,uintptr_t b,uintptr_t c,uintptr_t d)
+{
+    struct bcr_worker_context state;uintptr_t result;unsigned index=0;
+    struct bcr_thread *t=bcr_current(&index);
+    if(!t||__atomic_load_n(&bcr_control->armed,__ATOMIC_ACQUIRE)!=1||t->calls>=BCR_CALL_LIMIT)
+        return bfr_worker(a,b,c,d);
+    state.thread=t;state.index=index;state.depth=t->depth;state.calls=t->calls;t->depth++;
+    __TRY {result=bfr_worker(a,b,c,d);}
+    __FINALLY_CTX(bcr_worker_finally,&state);
+    return result;
+}
