+#pragma once
+
+/* Source synchronization carriers for qualified native render replacement. */
+#include "Metal.hpp"
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace dxmt {
+class NativeRenderCut {
+  inline static std::atomic_flag counts_lock_ = ATOMIC_FLAG_INIT;
+  inline static uint64_t render_count_ = 0, clear_count_ = 0, resolve_count_ = 0, present_count_ = 0;
+  static bool option(const char *name) {
+    const char *value = std::getenv(name);
+    return value && !std::strcmp(value, "1");
+  }
+
+  static WMT::RenderCommandEncoder carrier(WMT::CommandBuffer command, obj_handle_t ready) {
+    /* Never copy the original pass: even an empty original pass could clear,
+     * discard, store or resolve its attachments. This descriptor has NONE. */
+    WMTRenderPassInfo info{};
+    info.default_raster_sample_count = 1;
+    info.render_target_array_length = 1;
+    info.render_target_width = info.render_target_height = 1;
+    info.bedrock_cut_magic = UINT64_C(0x4244464355543033);
+    info.bedrock_cut_ready_fence = ready;
+    auto encoder = command.renderCommandEncoder(info);
+    require(bool(encoder));
+    encoder.setLabel(WMT::String::string("NativeRenderFenceCarrier", WMTUTF8StringEncoding));
+    /* The paired Unix bridge's fullframe_draw_cut_begin waits both ready and
+     * its associated attachment-load fence. A plain blit wait would lose the
+     * second edge and allow a later source upload to race its snapshot. */
+    return encoder;
+  }
+
+public:
+  enum class Kind { Render, Clear, Resolve, Present };
+
+  /* Counts name successfully encoded CUT branches, not GPU-completion or
+   * actual-presentation totals. One lock gives coherent multi-queue reports. */
+  static void suppressed(Kind kind) {
+    while (counts_lock_.test_and_set(std::memory_order_acquire))
+      counts_lock_.wait(true, std::memory_order_relaxed);
+    uint64_t *count = nullptr;
+    switch (kind) {
+    case Kind::Render: count = &render_count_; break;
+    case Kind::Clear: count = &clear_count_; break;
+    case Kind::Resolve: count = &resolve_count_; break;
+    case Kind::Present: count = &present_count_; break;
+    }
+    require(count && *count != UINT64_MAX);
+    ++*count;
+    if (kind == Kind::Present && (present_count_ == 1 || !(present_count_ % 64)))
+      std::fprintf(stderr, "[native-render-cut] render_suppressed=%llu clear_suppressed=%llu resolve_suppressed=%llu present_suppressed=%llu\n",
+          (unsigned long long)render_count_, (unsigned long long)clear_count_,
+          (unsigned long long)resolve_count_, (unsigned long long)present_count_);
+    counts_lock_.clear(std::memory_order_release);
+    counts_lock_.notify_one();
+  }
+
+  static void require(bool qualified) {
+    if (qualified) return;
+    std::fputs("[native-render] invalid qualification; refusing source render fallback\n", stderr);
+    std::abort();
+  }
+
+  static bool active(bool captured) {
+    if (!option("DXMT_NATIVE_RENDER")) return false;
+    require(option("DXMT_NATIVE_COMPLETION") && option("DXMT_FRAME_STREAM") && option("DXMT_CHUNK_STREAM"));
+    /* Explicit unarmed/uncaptured chunks continue through the original path.
+     * The completion Begin ABI rejects any bypass after capture has started. */
+    return captured;
+  }
+
+  template<typename RenderData, typename FencePool>
+  static void render(WMT::CommandBuffer command, RenderData *data, FencePool &fences, obj_handle_t ready) {
+    auto encoder = carrier(command, ready);
+    data->fence_wait.forEach(data->fence_wait_vertex,
+        [&](auto id) { encoder.waitForFence(fences[id], WMTRenderStagePreRaster); },
+        [&](auto id) { encoder.waitForFence(fences[id], WMTRenderStageFragment); });
+    data->fence_update_vertex.forEach(data->fence_update,
+        [&](auto id) { encoder.updateFence(fences[id], WMTRenderStageFragment); },
+        [&](auto id) { encoder.updateFence(fences[id], WMTRenderStagePreRaster); });
+    encoder.endEncoding();
+  }
+
+  template<typename EncoderData, typename FencePool>
+  static void utility(WMT::CommandBuffer command, EncoderData *data, FencePool &fences, obj_handle_t ready = 0) {
+    auto encoder = carrier(command, ready);
+    data->fence_wait.forEach([&](auto id) { encoder.waitForFence(fences[id], WMTRenderStageFragment); });
+    data->fence_update.forEach([&](auto id) { encoder.updateFence(fences[id], WMTRenderStageFragment); });
+    encoder.endEncoding();
+  }
+};
+} // namespace dxmt
