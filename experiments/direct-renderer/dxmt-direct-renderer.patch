+#pragma once
+
+/* Optional source/native completion join. Original rendering stays enabled. */
+#include "Metal.hpp"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace dxmt {
+struct NativeTimestampGroup {
+  uint64_t index, count, value;
+};
+
+class NativeCompletion {
+  struct Signal {
+    WMT::Reference<WMT::SharedEvent> event;
+    uint64_t id, value;
+  };
+  WMT::Reference<WMT::CommandBuffer> command_;
+  WMT::Reference<WMT::SharedEvent> queue_event_;
+  std::vector<Signal> signals_;
+  uint64_t stream_ = 0, chunk_ = 0, completion_ = 0;
+  bool captured_ = false;
+
+  [[noreturn]] static void fail() {
+    /* Never destroy native-owned readbacks, signal readiness, or recycle a
+     * chunk after missing, unknown, mismatched or terminal evidence. */
+    std::fputs("[native-completion] missing or invalid native evidence; refusing source readiness\n", stderr);
+    std::abort();
+  }
+
+  static bool option(const char *name) {
+    const char *value = std::getenv(name);
+    return value && !std::strcmp(value, "1");
+  }
+
+public:
+  bool captured() const { return captured_; }
+
+  void begin(WMT::CommandBuffer command, uint64_t stream, uint64_t chunk, uint64_t completion) {
+    if (!option("DXMT_NATIVE_COMPLETION")) return;
+    if (!option("DXMT_FRAME_STREAM") || !option("DXMT_CHUNK_STREAM")) fail();
+    uint32_t result = WMTFrameStreamCompletionBegin(command.handle, stream, chunk, completion);
+    if (result == WMTNativeCompletionBypass && !stream) return;
+    if (result != WMTNativeCompletionCaptured || !stream) fail();
+    command_ = command;
+    stream_ = stream; chunk_ = chunk; completion_ = completion;
+    captured_ = true;
+  }
+
+  void defer(WMT::SharedEvent event, uint64_t id, uint64_t value) {
+    if (!captured_ || !event || !id || !value) fail();
+    signals_.push_back({event, id, value});
+  }
+
+  /* Suppressed earlier signals cannot be waited on by this same original
+   * command buffer. Their original ordering already satisfies this wait. */
+  bool locallySatisfied(WMT::Event event, uint64_t value) const {
+    for (const auto &signal : signals_)
+      if (signal.event.handle == event.handle && signal.value >= value) return true;
+    return false;
+  }
+
+  void deferQueue(WMT::SharedEvent event) { queue_event_ = event; }
+
+  template<typename TimestampReadback, typename Clock = std::chrono::steady_clock>
+  void finish(TimestampReadback *timestamp, const std::atomic_bool *stopped = nullptr) {
+    if (!captured_) return;
+    /* Source returns SUSPENDED only after GPU/query/readback readiness and
+     * while actual Present is pending for a fresh, authenticated hidden game
+     * window. Pause that interval only; keep accumulated active time. */
+    typename Clock::duration active_elapsed{};
+    auto checkpoint = Clock::now();
+    uint32_t state, previous = WMTNativeCompletionPending;
+    auto report_wait = [&](const char *reason) {
+      std::fprintf(stderr, "[native-completion-wait] reason=%s state=%u active_ms=%lld stream=%llu chunk=%llu completion=%llu\n",
+          reason, state, (long long)std::chrono::duration_cast<std::chrono::milliseconds>(active_elapsed).count(),
+          (unsigned long long)stream_, (unsigned long long)chunk_, (unsigned long long)completion_);
+    };
+    do {
+      if (stopped && stopped->load(std::memory_order_acquire)) fail();
+      state = WMTFrameStreamCompletionWait(command_.handle, stream_, chunk_, completion_, 50);
+      const auto now = Clock::now();
+      if (state != WMTNativeCompletionSuspended) active_elapsed += now - checkpoint;
+      checkpoint = now;
+      if (state != previous && (state == WMTNativeCompletionSuspended || previous == WMTNativeCompletionSuspended))
+        report_wait("suspension-transition");
+      previous = state;
+      if (active_elapsed >= std::chrono::seconds(30)) { report_wait("active-deadline"); fail(); }
+      if (stopped && stopped->load(std::memory_order_acquire)) fail();
+      if (state != WMTNativeCompletionPending && state != WMTNativeCompletionSuspended &&
+          state != WMTNativeCompletionReady) { report_wait("terminal-evidence"); fail(); }
+    } while (state == WMTNativeCompletionPending || state == WMTNativeCompletionSuspended);
+    if (state != WMTNativeCompletionReady || !queue_event_) fail();
+
+    std::vector<NativeTimestampGroup> groups;
+    if (timestamp) groups = timestamp->nativeGroups();
+    /* Fetch/validate every exact group before making any query visible.
+     * Count is object multiplicity at one sample index, never an index range. */
+    for (auto &group : groups) {
+      if (WMTFrameStreamCompletionQuery(command_.handle, stream_, chunk_, completion_,
+            1 /* FFSC_TIMESTAMP */, chunk_, group.index, group.count, 0, &group.value)
+              != WMTNativeCompletionReady || !group.value) fail();
+    }
+    for (const auto &signal : signals_) {
+      uint64_t value = 0;
+      if (WMTFrameStreamCompletionQuery(command_.handle, stream_, chunk_, completion_,
+            3 /* FFSC_EVENT_QUERY */, signal.id, 0, 1, signal.value, &value)
+              != WMTNativeCompletionReady || value != signal.value) fail();
+    }
+    /* Preserve exact native ns and monotonic API behavior. Regressing native
+     * evidence is a protocol failure; do not replace samples with a clamp. */
+    thread_local uint64_t latest_native_ns = 0;
+    uint64_t latest = latest_native_ns;
+    for (const auto &group : groups) {
+      if (group.value < latest) fail();
+      latest = group.value;
+    }
+    if (timestamp) timestamp->issueNative(groups);
+    if (WMTFrameStreamCompletionRelease(command_.handle, stream_, chunk_, completion_)
+          != WMTNativeCompletionReady) fail();
+
+    /* EVENT GetData reads these objects directly. Neither automatic queue
+     * progress nor explicit signals may escape before the entire native join. */
+    latest_native_ns = latest;
+    for (auto &signal : signals_)
+      signal.event.signalValue(std::max(signal.event.signaledValue(), signal.value));
+    queue_event_.signalValue(std::max(queue_event_.signaledValue(), completion_));
+    captured_ = false;
+  }
+};
+} // namespace dxmt
